# Flatpak manifest, generated from packaging/linux/flatpak/app.yml.in by
# cmake/MauvelyAppInfo.cmake.
#
# ── Why org.kde.Platform and not org.freedesktop.Platform ────────────────────
#
# These are Qt Widgets apps. The KDE runtime ships Qt 6 — including QtWebEngine,
# which Compose needs — so the manifest stays short. Building Qt against the
# freedesktop runtime would mean carrying Qt as a module and a ~40 minute build.
#
# ── The thing that catches everyone: no network in the build sandbox ─────────
#
# flatpak-builder runs each module's build with networking disabled. Anything an
# app fetches at configure time therefore has to become a `sources:` entry here
# instead:
#
#   · Sotto pulls whisper.cpp through FetchContent. Add it as a source below and
#     pass -DFETCHCONTENT_SOURCE_DIR_WHISPER so CMake uses the staged tree.
#   · Relay builds a Rust crate through Corrosion. Generate cargo-sources.json
#     with flatpak-cargo-generator.py and set CARGO_NET_OFFLINE=1.
#
# A configure that "works locally and hangs in the Flatpak build" is always this.
app-id: @MAUVELY_APP_ID@
runtime: org.kde.Platform
runtime-version: '6.7'
sdk: org.kde.Sdk
command: @MAUVELY_APP_BINARY@

finish-args:
  - --share=ipc
  - --socket=fallback-x11
  - --socket=wayland
  - --device=dri
  # Settings are QSettings INI files under the sandboxed config dir; nothing
  # reaches outside it. Apps that genuinely need host paths add their own
  # --filesystem= line rather than widening this default.
  - --share=network

modules:
  - name: @MAUVELY_APP_KEY@
    buildsystem: cmake-ninja
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      # The AppStream id must match the flatpak app id; a mismatch passes the
      # build and then shows two entries in the software centre.
      - -DCMAKE_INSTALL_PREFIX=/app
    sources:
      # `dir` rather than `git`: this builds the working tree, so a local
      # `scripts/package.sh --format flatpak` needs no commit and no tag, and CI
      # builds exactly the checkout it tested.
      - type: dir
        path: @MAUVELY_APP_SOURCE_DIR@
