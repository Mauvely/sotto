# Flatpak manifest for Sotto, generated from this template by
# cmake/MauvelyAppInfo.cmake.
#
# This one diverges from the shared template on purpose. Every app's manifest
# does to some degree — finish-args are the app's own permissions and cannot be
# generic — but Sotto needs one structural change the others do not.
#
# ── whisper.cpp, and the sandbox with no network ────────────────────────────
#
# CMakeLists.txt pulls whisper.cpp through FetchContent at configure time.
# flatpak-builder runs every module's build with networking disabled, so that
# fetch cannot happen: the configure would hang and then fail.
#
# So whisper.cpp is declared as a source here instead, pinned to the same tag
# CMakeLists.txt names, and FETCHCONTENT_SOURCE_DIR_WHISPER points CMake at the
# staged tree. FetchContent honours that variable and skips the download
# entirely — the same mechanism distributions use to build a FetchContent
# project offline.
#
# The two tags must stay in step. A mismatch does not fail the build; it
# silently ships a different whisper than the one the app was tested against.
app-id: @MAUVELY_APP_ID@
runtime: org.kde.Platform
runtime-version: '6.11'
sdk: org.kde.Sdk
command: @MAUVELY_APP_BINARY@

finish-args:
  - --share=ipc
  - --socket=fallback-x11
  - --socket=wayland
  - --device=dri
  # Audio capture. Sotto's whole job is listening to the microphone, so this is
  # not optional the way it is for the other apps.
  - --socket=pulseaudio
  # Downloading speech models from Hugging Face on first run.
  - --share=network
  #
  # Deliberately NOT --socket=session-bus. Sotto reaches the outside world
  # through xdg-desktop-portal — GlobalShortcuts for the hotkey, RemoteDesktop
  # for synthesising the paste keystroke — and portals are available to a
  # sandboxed app without any extra permission, because going through them is
  # the point. Opening the whole session bus would hand it every other service
  # on there to buy nothing.
  #
  # The consequence worth knowing: the ydotool and wl-clipboard fallbacks do not
  # exist inside the sandbox, so a Flatpak install has the portal path or
  # clipboard-only. On a portal-less desktop that means "Copy to clipboard",
  # which the app already degrades to and says so in Settings.

modules:
  # ── LayerShellQt ──────────────────────────────────────────────────────────
  #
  # Not in org.kde.Platform, and without it the HUD falls back to a plain
  # always-on-top window: on Wayland that means the compositor, not Sotto,
  # decides where it goes and whether it stays above a fullscreen window. For a
  # dictation overlay that is the difference between working and nearly working,
  # so it is worth the extra module.
  # ECM is a set of CMake modules, not a library — it builds in seconds and
  # nothing links against it. Kept as a module rather than relied on from the
  # runtime so that layer-shell-qt's ECM requirement is satisfied by something
  # this manifest pins, instead of by whatever the runtime happens to ship on
  # the day. `cleanup: '*'` keeps all of it out of the finished app.
  - name: extra-cmake-modules
    buildsystem: cmake-ninja
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DBUILD_TESTING=OFF
    sources:
      - type: git
        url: https://invent.kde.org/frameworks/extra-cmake-modules.git
        tag: v6.29.0
    cleanup:
      - '*'

  - name: layer-shell-qt
    buildsystem: cmake-ninja
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DBUILD_TESTING=OFF
    sources:
      - type: git
        url: https://invent.kde.org/plasma/layer-shell-qt.git
        # 6.7 to match the runtime's Qt, and because src/ui/OverlayController.cpp
        # calls setWantsToBeOnActiveScreen(), which 6.2 does not have — pinning
        # an older tag fails the build at that call rather than at configure.
        tag: v6.7.4

  - name: @MAUVELY_APP_KEY@
    buildsystem: cmake-ninja
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DCMAKE_INSTALL_PREFIX=/app
      # cpu, not a GPU backend: HIP and CUDA need toolchains the runtime does
      # not have, and a Flatpak has to run on whatever hardware installs it.
      - -DSOTTO_GPU=cpu
      # whisper.cpp is staged as a source of *this* module rather than built as
      # its own. flatpak-builder deletes a module's source tree once that module
      # is finished, so a separate whisper module leaves nothing behind for
      # FetchContent to point at — the first attempt failed with exactly that:
      #
      #   Manually specified source directory is missing:
      #     FETCHCONTENT_SOURCE_DIR_WHISPER --> /run/build/whisper-cpp
      #
      # As a source of this module it lands inside our own build directory and
      # is still there when CMake configures.
      - -DFETCHCONTENT_SOURCE_DIR_WHISPER=/run/build/@MAUVELY_APP_KEY@/whisper-src
    sources:
      # `dir` rather than `git`: this builds the working tree, so a local
      # `scripts/package.sh --format flatpak` needs no commit and no tag, and CI
      # builds exactly the checkout it tested.
      #
      # `skip` keeps local build trees out of the copy. Sotto's holds whisper's
      # object files and the downloaded tool AppImages — gigabytes of things the
      # sandbox is about to rebuild anyway.
      - type: dir
        path: @MAUVELY_APP_SOURCE_DIR@
        skip:
          - build
          - build-pkg
          - packaging/linux/.cache
          - OLD VERSION
      - type: git
        url: https://github.com/ggml-org/whisper.cpp.git
        tag: v1.9.1
        # Pinned by commit as well as tag: a tag can be moved, and a silently
        # different whisper is exactly the failure this is guarding against.
        # Must match GIT_TAG in CMakeLists.txt.
        commit: f049fff95a089aa9969deb009cdd4892b3e74916
        dest: whisper-src
