<?xml version="1.0" encoding="UTF-8"?>

<!--
  Per-user WiX template.

  A copy of CMake's stock Modules/Internal/CPack/WIX.template.in with exactly
  one change: InstallScope="perUser" on <Package>. Everything else is verbatim
  so that a CMake upgrade which changes the stock template stays easy to diff
  against this one.

  Why it exists: CPack has no variable for install scope, and the default is
  per-machine. A per-machine MSI needs administrator rights, so every
  auto-update would raise a UAC prompt — which defeats the point of an updater
  that is supposed to apply itself quietly. With this, the app installs under
  %LOCALAPPDATA% and `msiexec /i <new>.msi /passive /norestart` upgrades it
  without interrupting anyone.

  This element alone is not enough: the directory tree must be reparented too,
  via CPACK_WIX_ROOT_FOLDER_ID=LocalAppDataFolder. cmake/MauvelyPackaging.cmake
  sets both together — do not use one without the other, or the install lands
  in Program Files and quietly asks for elevation forever after.

  InstallScope="perUser" makes WiX author ALLUSERS="" and MSIINSTALLPERUSER
  itself. Do not also declare those properties by hand; WiX rejects the
  duplicate symbols.
-->

<?include "cpack_variables.wxi"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" @CPACK_WIX_CUSTOM_XMLNS_EXPANDED@
    RequiredVersion="3.6.3303.0">

    <Product Id="$(var.CPACK_WIX_PRODUCT_GUID)"
        Name="$(var.CPACK_PACKAGE_NAME)"
        Language="1033"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)">

        <Package InstallerVersion="301" Compressed="yes" InstallScope="perUser"/>

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT"/>

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON">ProductIcon.ico</Property>
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)"/>
        <?endif?>

        <FeatureRef Id="ProductFeature"/>

        <UIRef Id="$(var.CPACK_WIX_UI_REF)" />

        <?include "properties.wxi"?>
        <?include "product_fragment.wxi"?>
    </Product>
</Wix>
